<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": better-matrix-windows-x86_64-setup.exe, built by
  Inno Setup around the executable signed with "app" (.github/workflows/release.yml). SignPath
  keeps its own copy; paste this into the project's artifact configuration with the slug
  "installer" when it changes. The product name and version come from better-matrix.iss.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file product-name="Better Matrix" product-version="${version}">
    <authenticode-sign description="Better Matrix installer" description-url="https://github.com/m43i/better-matrix" />
  </pe-file>
</artifact-configuration>
