<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": the bare better-matrix.exe the release uploads before
  packaging it (.github/workflows/release.yml). SignPath keeps its own copy; paste this into the
  project's artifact configuration with the slug "app" when it changes. The product name and
  version must match the executable's version resource (apps/desktop/build.rs).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file product-name="Better Matrix" product-version="${version}">
    <authenticode-sign description="Better Matrix" description-url="https://github.com/m43i/better-matrix" />
  </pe-file>
</artifact-configuration>
