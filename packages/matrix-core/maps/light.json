{
  "version": 8,
  "name": "Better Matrix Light",
  "sources": {
    "planet": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f5f2"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "planet",
      "source-layer": "park",
      "paint": {
        "fill-color": "#dcebdc"
      }
    },
    {
      "id": "greenery",
      "type": "fill",
      "source": "planet",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "farmland"],
      "paint": {
        "fill-color": "#dcebdc"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "planet",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c1deef"
      }
    },
    {
      "id": "streams",
      "type": "line",
      "source": "planet",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#c1deef",
        "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 7, 0.5, 12, 1, 19, 5]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "planet",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e5e6e3",
        "fill-outline-color": "#d7d9d6"
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "planet",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "path", "track"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d7d9d6",
        "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 7, 0.5, 12, 1, 19, 3]
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "planet",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "minor", "service", "tertiary", "secondary", "primary", "trunk", "motorway"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 7, 0.5, 12, 2, 19, 25]
      }
    },
    {
      "id": "main-roads",
      "type": "line",
      "source": "planet",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "primary", "trunk", "motorway"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f7e4b8",
        "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 7, 0.5, 12, 1.6, 19, 17]
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "planet",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line",
        "symbol-spacing": 190
      },
      "paint": {
        "text-color": "#62707a",
        "text-halo-color": "#f4f5f2",
        "text-halo-width": 1.35
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "planet",
      "source-layer": "place",
      "minzoom": 1,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 20]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f4f5f2",
        "text-halo-width": 1.35
      }
    }
  ]
}
