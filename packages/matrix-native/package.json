{
  "name": "@better-matrix/matrix-native",
  "version": "0.0.2",
  "private": true,
  "description": "The Better Matrix engine (matrix-core) for React Native: a JSI turbo module generated by uniffi-bindgen-react-native from packages/matrix-ffi, and a typed client for it.",
  "license": "MIT",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --and-generate && bun scripts/webrtc-jar.ts",
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --and-generate",
    "ubrn:generate": "ubrn generate all --config ubrn.config.yaml",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-7",
    "uniffi-bindgen-react-native": "0.31.0-7"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "MatrixNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "chat.bettermatrix.matrixnative"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m43i/better-matrix.git",
    "directory": "packages/matrix-native"
  },
  "homepage": "https://github.com/m43i/better-matrix#readme",
  "author": "Better Matrix contributors",
  "exports": {
    ".": "./src/index.tsx",
    "./client": "./src/client/index.ts",
    "./types": "./src/generated/types/index.ts",
    "./package.json": "./package.json",
    "./native": "./src/native.ts"
  }
}
